# Search provider to use: serper or mock
SEARCH_PROVIDER=serper

# Serper API key from https://serper.dev
SERPER_API_KEY=your_serper_key_here

# Review-to-sales multiplier (default heuristic)
REVIEW_TO_SALES_MULTIPLIER=50

# Currency conversion estimates for display only
USD_TO_CZK=23.2
EUR_TO_CZK=25.3
