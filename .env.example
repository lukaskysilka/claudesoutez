# Search provider to use: mock (runs instantly) or serper (real API)
SEARCH_PROVIDER=mock

# Optional: Serper API key from https://serper.dev (required only when SEARCH_PROVIDER=serper)
SERPER_API_KEY=

# Review-to-sales multiplier (default heuristic)
REVIEW_TO_SALES_MULTIPLIER=50

# Currency conversion estimates for display only
USD_TO_CZK=23.2
EUR_TO_CZK=25.3
