# ─────────────────────────────────────────────────────────────────────────────
# Movit Energy — Market Size Estimator  |  Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Search API ───────────────────────────────────────────────────────────────
# Get your Serper API key at https://serper.dev (primary provider)
SERPER_API_KEY=your_serper_api_key_here

# Optional: Google Custom Search fallback
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_CSE_ID=your_custom_search_engine_id_here

# ── Estimation Tuning ─────────────────────────────────────────────────────────
# 1 review ≈ N sales  (industry standard for supplements: 50)
REVIEW_TO_SALES_RATIO=50

# Max competitors returned per region (1–10)
MAX_COMPETITORS_PER_REGION=10

# ── Scraper ───────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=10
MAX_CONCURRENT_SCRAPES=5
